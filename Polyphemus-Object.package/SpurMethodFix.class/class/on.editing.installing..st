instance creation
on: aReifiedMemory editing: aSpurEdit installing: aSpurMethodInstall

	"A fix for methods of that reading. The edit writes code that fits where it is; the
	installer, which may be nil, makes room when it does not."

	^ self new
		  setReading: aReifiedMemory editing: aSpurEdit installing: aSpurMethodInstall;
		  yourself
